// The DMC $a1 engine. A call counts the tempo down (the first calls after the init count a start-up
// delay instead); on a row each voice counts its note's duration down and, out of rows, reads the
// next note: the orderlist names a pattern ($FF jumps, $FD and $FC transpose, $FE ends the voice),
// the pattern's commands set duration, instrument, slide and the volume and filter state until a
// note, a rest or a slide ends the row. A note starts the sound on the next call; from then on every
// call steps the instrument's pulse and filter programs, then slides or vibrates and plays the wave.
// The player's other entries run one voice's steady call, its volume fade and wave step, or its wave
// step alone, for the voice in X.
spec dmc_a1;

layout {
  patlo, pathi, inst, wtctrl, wtarg, pwa, pwb, filta, filtb, freqlo, freqhi, tempo: addr;
  order_lo, order_hi: addr;
  rel_clears_sr: flag;
  call: byte;
  wild_freq_lo, wild_freq_hi: list;
  init_tempo_ctr, init_mode, init_cutoff, init_fade_up, init_fade_down, init_vib_shift,
  init_vol, init_delta, init_filt_pos, init_fc, init_sl, init_filt_start, init_sr_tmp,
  init_pw_start, init_startup, init_cutoff_ovr: byte;
  init_active, init_key, init_seqpos, init_patpos, init_left, init_dur, init_instr, init_trans,
  init_sus_over, init_tie, init_slide_speed, init_slide_to, init_wave_pos, init_pw_pos,
  init_vib_delay, init_vib_period, init_vib, init_mark, init_fresh, init_freq, init_ctrl,
  init_gate, init_term, init_pw, init_pw_cnt, init_vib_grown, init_vib_dir, init_vib_pos,
  init_slide: list;
}

const PLAY = 0;
const STEADY = 1;
const FADE = 2;
const WAVE = 3;
const CUTOFF_LO = 0x15;
const CUTOFF_HI = 0x16;
const ROUTE = 0x17;
const MODE_VOL = 0x18;

event order_byte: note;
event pattern_byte: note;
event pattern_end: note;

cell sid: u8[0x19] @ 0xD400 out;

cell order_ptr: u16[3] @ (L.order_lo, L.order_hi) ro;
cell pat_ptr: u16[256] @ (L.patlo, L.pathi) ro;
table instrument @ L.inst stride 8 {
  ad: u8; sr: u8; wave: u8; pulse: u8; filter: u8; vib_delay: u8; vib_period: u8; vib: u8;
}
cell speed: u8 @ L.tempo ro;

cell freq_lo: u8[256] @ L.freqlo ro;
cell freq_hi: u8[256] @ L.freqhi ro;
cell wave_ctrl: u8[256] @ L.wtctrl ro;
cell wave_arg: u8[256] @ L.wtarg ro;
cell pulse_prog: u16[256] @ (L.pwb, L.pwa) ro;
cell filter_prog: u16[256] @ (L.filtb, L.filta) ro;

state wild_lo: u8[256] ro = L.wild_freq_lo;
state wild_hi: u8[256] ro = L.wild_freq_hi;

state tempo_ctr: u8 = L.init_tempo_ctr;
state mode: u8 = L.init_mode;
state cutoff: u16 = L.init_cutoff;
state fade_up: u8 = L.init_fade_up;
state fade_down: u8 = L.init_fade_down;
state vib_shift: u8 = L.init_vib_shift;
state vol: u16 = L.init_vol;
state delta: u16 = L.init_delta;
state filt_pos: u8 = L.init_filt_pos;
state fc: u16 = L.init_fc;
state sl: u16 = L.init_sl;
state filt_start: u8 = L.init_filt_start;
state sr_tmp: u8 = L.init_sr_tmp;
state pw_start: u8 = L.init_pw_start;
state startup: u8 = L.init_startup;
state cutoff_ovr: u8 = L.init_cutoff_ovr;

machine clock {
  signal run: bool = true;
  signal row: bool = false;
  counter beat: tempo_ctr { on frame -= 1; reload speed; wrap when neg(tempo_ctr - 1); }

  step {
    if startup != 0 {
      startup -= 1;
      run := false;
    } else {
      fire frame;
      row := speed == tempo_ctr;
    }
  }
}

machine voice[x in 0..3] {
  record chip @ 0xD400 stride 7 { out_freq: u16; out_pw: u12; out_ctrl: u8; out_ad: u8; out_sr: u8; }

  state active: u8 = L.init_active[x];
  state key: u8 = L.init_key[x];
  state seqpos: u8 = L.init_seqpos[x];
  state patpos: u8 = L.init_patpos[x];
  state left: u8 = L.init_left[x];
  state dur: u8 = L.init_dur[x];
  state instr: u8 = L.init_instr[x];
  state trans: u8 = L.init_trans[x];
  state down: u8 = 0;
  state shifted: u8 = 0;
  state sus_over: u8 = L.init_sus_over[x];
  state tie: u8 = L.init_tie[x];
  state slide_speed: u8 = L.init_slide_speed[x];
  state slide_to: u8 = L.init_slide_to[x];
  state wave_pos: u8 = L.init_wave_pos[x];
  state pw_pos: u8 = L.init_pw_pos[x];
  state vib_delay: u8 = L.init_vib_delay[x];
  state vib_period: u8 = L.init_vib_period[x];
  state vib: u16 = L.init_vib[x];
  state mark: u8 = L.init_mark[x];
  state fresh: u8 = L.init_fresh[x];
  state freq: u16 = L.init_freq[x];
  state ctrl: u8 = L.init_ctrl[x];
  state gate: u8 = L.init_gate[x];
  state term: u8 = L.init_term[x];
  state pw: u16 = L.init_pw[x];
  state pw_cnt: u16 = L.init_pw_cnt[x];
  state vib_grown: u8 = L.init_vib_grown[x];
  state vib_dir: u8 = L.init_vib_dir[x];
  state vib_pos: u8 = L.init_vib_pos[x];
  state slide: u16 = L.init_slide[x];
  state a1: u8 = 0;
  state a2: u8 = 0;
  state a3: u8 = 0;
  signal read: bool = false;

  counter remaining: left { on row -= 1; wrap when left == 1 -> note; }

  cursor orderlist {
    table @ order_ptr[x] width 2;
    pos seqpos;
    on order_byte step;
    match c0 {
      0xFF => jump(c1);
      0xFD => end take 2 then trans = c1, down = 0, shifted = 1;
      0xFC => end take 2 then trans = 0, down = c1, shifted = 1;
      _ => stop;
    }
  }

  cursor pattern {
    table @ pat_ptr[orderlist.c0] width 4;
    pos patpos;
    on pattern_byte step; on pattern_end reset;
    match c0 {
      0x00..0x7F, 0xFE, 0xF4, 0xF5 => end take 1;
      0xF1, 0xF2, 0xF9 => end take 2 then a1 = c1;
      0xFA => end take 3 then a1 = c1, a2 = c2;
      0xFB => end take 3 then a1 = c1, a2 = c2, a3 = c3;
      0xFD => value(dur = c1) take 2;
      0xFC => value(instr = c1) take 2;
      0xF3 => value(sus_over = c1) take 2;
      0xF8 => value(cutoff_ovr = c1) take 2;
      0xF7 => value(fade_up = c1) take 2;
      0xF6 => value(fade_down = c1) take 2;
      _ => value() take 2;
    }
  }

  handler next_entry on pattern_end {
    seqpos += 1;
    sus_over := 0;
    tie := 0;
  }

  proc variable(code: u8, memory: u8) -> u8 {
    for k in 0..3 {
      if code & 3 == k {
        match code >> 2 {
          1 => return tempo_ctr;
          2 => return mode;
          3 => return lo(cutoff);
          4 => return hi(cutoff);
          5 => return fade_up;
          6 => return fade_down;
          7 => return vib_shift;
          8 => return lo(vol);
          9 => return hi(vol);
          10 => return lo(delta);
          11 => return hi(delta);
          12 => return filt_pos;
          13 => return lo(fc);
          14 => return hi(fc);
          15 => return lo(sl);
          16 => return hi(sl);
          17 => return filt_start;
          18 => return sr_tmp;
          19 => return pw_start;
          20 => return startup;
          21 => return cutoff_ovr;
          22 => return voice[k].active;
          23 => return voice[k].key;
          24 => return voice[k].seqpos;
          25 => return voice[k].patpos;
          26 => return voice[k].left;
          27 => return voice[k].dur;
          28 => return voice[k].instr;
          29 => return voice[k].trans - voice[k].down;
          30 => return voice[k].sus_over;
          31 => return voice[k].tie;
          32 => return voice[k].slide_speed;
          33 => return voice[k].slide_to;
          34 => return voice[k].wave_pos;
          35 => return voice[k].pw_pos;
          36 => return voice[k].vib_delay;
          37 => return voice[k].vib_period;
          38 => return lo(voice[k].vib);
          39 => return hi(voice[k].vib);
          40 => return voice[k].mark;
          41 => return voice[k].fresh;
          42 => return lo(voice[k].freq);
          43 => return hi(voice[k].freq);
          44 => return voice[k].ctrl;
          45 => return voice[k].gate;
          46 => return voice[k].term;
          47 => return lo(voice[k].pw);
          48 => return hi(voice[k].pw);
          49 => return lo(voice[k].pw_cnt);
          50 => return hi(voice[k].pw_cnt);
          51 => return voice[k].vib_grown;
          52 => return voice[k].vib_dir;
          53 => return voice[k].vib_pos;
          54 => return lo(voice[k].slide);
          55 => return hi(voice[k].slide);
          _ => return memory;
        }
      }
    }
    return memory;
  }

  proc pitch_lo(n: u8) -> u8 {
    let b = variable(wild_lo[n], freq_lo[n]);
    return b;
  }

  proc pitch_hi(n: u8) -> u8 {
    let b = variable(wild_hi[n], freq_hi[n]);
    return b;
  }

  proc set_pitch(n: u8) {
    let low = pitch_lo(n);
    freq := word(low, hi(freq));
    let high = pitch_hi(n);
    freq := word(low, high);
  }

  handler fetch on note {
    read := true;
    read_row();
  }

  proc read_row() {
    react orderlist on order_byte();
    if shifted != 0 {
      shifted := 0;
    } elif orderlist.c0 == 0xFE {
      active := 0;
      wave_output();
      return;
    }
    let walking = true;
    while walking bound 600 {
      let done = false;
      let row = 0;
      while !done bound 300 {
        row := pattern.c0;
        react pattern on pattern_byte() -> done;
      }
      walking := false;
      match row {
        0xFE => rest();
        0xF4 => { gate ^= 1; rest(); }
        0xF5 => { tie ^= 0xFF; walking := true; }
        0xF9 => { filter_command(a1); walking := true; }
        0xF2 => { out_ad := a1; walking := true; }
        0xF1 => { out_sr := a1; walking := true; }
        0xFB => {
          slide_speed := a1;
          key := a2 + trans - down;
          slide_to := a3 + trans - down;
          if slide_to == 0 {
            rest();
          } else {
            patpos += 1;
            onset();
          }
        }
        0xFA => {
          slide_speed := a1;
          slide_to := a2 + trans - down;
          rest();
        }
        _ => {
          key := row + trans - down;
          if tie != 0 { rest(); } else { onset(); }
        }
      }
    }
  }

  proc filter_command(b: u8) {
    sid[ROUTE] := ite(b == 0, 0, (b << 4) | 4);
    mode := b & 0xF0;
  }

  proc rest() {
    left := dur;
    term := pattern.c0;
    if term == 0xFF {
      fire pattern_end;
    }
    wave_output();
  }

  proc onset() {
    let at = instr << 3;
    let sr = instrument[at >> 3].sr;
    if sus_over != 0 {
      sr_tmp := sus_over << 4;
      sr := (sr & 0x0F) | sr_tmp;
    }
    out_sr := sr;
    out_ad := instrument[at >> 3].ad;
    left := dur;
    mark := 0;
    out_ctrl := 0x09;
    fresh := 0x09;
    out_freq := 0;
    term := pattern.c0;
    if term == 0xFF {
      fire pattern_end;
    }
  }

  proc sound() {
    let at = (instr << 3) >> 3;
    fresh := 0;
    sid[MODE_VOL] := mode | hi(vol);
    vib_delay := instrument[at].vib_delay;
    vib_period := instrument[at].vib_period;
    vib_shift := instrument[at].vib & 7;
    wave_pos := instrument[at].wave;
    pw_start := instrument[at].pulse;
    if pw_start != 0 {
      pw_pos := pw_start;
    }
    filt_start := instrument[at].filter;
    if filt_start != 0 {
      filt_pos := filt_start;
    }
    wave_step(false);
    gate := 0xF7;
    if pw_start != 0 && pw_pos != 0 {
      pw := pulse_prog[pw_pos];
      pw_cnt := 0;
      pw_pos += 1;
    }
    if filt_start != 0 {
      if cutoff_ovr != 0 {
        cutoff := word(0, cutoff_ovr);
      } else {
        cutoff := filter_prog[filt_pos];
      }
      fc := 0;
      filt_pos += 1;
    }
    mark := 0;
    vib_grown := 0;
    vib_dir := 0;
    vib_pos := 0;
    slide := 0;
    let high = pitch_hi(key);
    vib := u16(high) << vib_shift;
    output();
  }

  proc modulate() {
    if fresh != 0 {
      sound();
      return;
    }
    pulse_program();
    if x == 2 {
      filter_program();
    }
    if slide_speed != 0 {
      portamento();
    } else {
      vibrato();
    }
  }

  proc pulse_program() {
    if hi(pulse_prog[pw_pos]) == 0x90 {
      pw_pos := lo(pulse_prog[pw_pos]);
    }
    delta := pulse_prog[pw_pos];
    pw += delta;
    pw_cnt += 1;
    if pw_cnt == pulse_prog[pw_pos + 1] {
      pw_cnt := 0;
      pw_pos += 2;
    }
  }

  proc filter_program() {
    if hi(filter_prog[filt_pos]) == 0x90 {
      filt_pos := lo(filter_prog[filt_pos]);
    }
    delta := filter_prog[filt_pos];
    cutoff += delta;
    fc += 1;
    if fc == filter_prog[filt_pos + 1] {
      fc := 0;
      filt_pos += 2;
    }
  }

  proc portamento() {
    let up = key < slide_to;
    if up {
      slide += u16(slide_speed);
    } else {
      slide -= u16(slide_speed);
    }
    sl := freq + slide;
    let target_hi = pitch_hi(slide_to);
    let target_lo = pitch_lo(slide_to);
    let reached = hi(sl) == target_hi;
    if !up {
      reached := hi(sl) < target_hi || (hi(sl) == target_hi && lo(sl) < target_lo);
    }
    if reached {
      key := slide_to;
      set_pitch(slide_to);
      slide := 0;
      slide_speed := 0;
      vibrato();
    } else {
      fade();
      wave_output();
    }
  }

  proc vibrato() {
    if tie != 0 {
      slide := 0;
    } elif vib_period != 0 {
      if vib_delay != 0 {
        vib_delay -= 1;
      } elif vib_dir == 0 {
        slide += vib;
        vib_pos += 1;
        if vib_pos == vib_period {
          vib_pos := 0;
          vib_dir += 1;
          if vib_grown == 0 {
            vib := vib << 1;
            vib_grown += 1;
          }
        }
      } else {
        slide -= vib;
        vib_pos += 1;
        if vib_pos == vib_period {
          vib_pos := 0;
          vib_dir -= 1;
        }
      }
    }
    fade();
    wave_output();
  }

  proc fade() {
    if fade_down != 0 {
      vol -= u16(fade_down);
      if hi(vol) == 0 {
        fade_down := 0;
      }
    }
    if fade_up != 0 {
      vol += u16(fade_up);
      if hi(vol) == 0x0F {
        fade_up := 0;
      }
    }
    sid[MODE_VOL] := hi(vol) | mode;
  }

  proc wave_step(running: bool) {
    if running && wave_ctrl[wave_pos] == 0x90 {
      wave_pos := wave_arg[wave_pos];
    }
    ctrl := wave_ctrl[wave_pos];
    if ctrl & 8 != 0 {
      freq := word(0, wave_arg[wave_pos]);
    } else {
      set_pitch(wave_arg[wave_pos] + key);
    }
    wave_pos += 1;
  }

  proc wave_output() {
    wave_step(true);
    output();
  }

  proc release() {
    let held = tie != 0;
    if term == 0xF5 {
      held := !held;
    }
    if held {
      return;
    }
    if left == 1 {
      if L.rel_clears_sr {
        out_sr := 0;
      }
      return;
    }
    if left == 2 && tempo_ctr == 0 {
      gate := 0xF6;
    }
  }

  proc output() {
    match term {
      0xFE, 0xF4, 0xFA, 0xF2, 0xF1 => {}
      _ => release();
    }
    out_freq := freq + slide;
    out_pw := pw;
    out_ctrl := ctrl & gate;
  }

  step {
    if L.call == PLAY {
      if clock.run {
        if clock.row && active != 0 {
          fire row;
        }
        if !read {
          modulate();
        }
      }
    } elif cpu.x == x {
      if L.call == STEADY {
        modulate();
      } elif L.call == FADE {
        fade();
        wave_output();
      } else {
        wave_output();
      }
    }
  }
}

machine filter_out {
  step {
    if clock.run {
      sid[CUTOFF_LO] := lo(cutoff);
      sid[CUTOFF_HI] := hi(cutoff);
    }
  }
}

schedule {
  if L.call != PLAY {
    voice[0];
    voice[1];
    voice[2];
  } else {
    clock;
    voice[0];
    voice[1];
    voice[2];
    filter_out;
  }
}
